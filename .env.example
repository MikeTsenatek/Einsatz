git# Required: replace both values with unique, strong secrets before deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Comma-separated hostnames/origins accepted by Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Set both to true when HTTPS is terminated by a trusted reverse proxy.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false

HTTP_PORT=8080
POSTGRES_DB=einsatzleitsoftware
POSTGRES_USER=einsatzleitsoftware

# Optional Keycloak SSO. Configure the Keycloak client redirect URI as
# https://<your-domain>/oidc/callback/ and add a groups claim to userinfo or ID token.
# All five values below are required to enable SSO; the group match is exact.
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REQUIRED_GROUP=
KEYCLOAK_GROUPS_CLAIM=groups
# Name of the optional Keycloak client scope containing the groups mapper.
KEYCLOAK_GROUPS_SCOPE=groups